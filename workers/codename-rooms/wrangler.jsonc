{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fungibus-codename-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODENAME_ROOMS",
        "class_name": "CodenameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodenameRoom"
      ]
    }
  ]
}
