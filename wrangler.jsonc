{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fungibus-games",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODENAME_ROOMS",
        "class_name": "CodenameRoom",
        "script_name": "fungibus-codename-rooms"
      }
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
