{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fungibus-games",
  "main": "src/index.js",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODENAME_ROOMS",
        "class_name": "CodenameRoom"
      },
      {
        "name": "SKULL_ROOMS",
        "class_name": "SkullRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodenameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SkullRoom"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
